{
  "name": "dsh-shell-wallpaper",
  "version": "0.4.4",
  "description": "One image behind the whole DSH shell, with a bundled default picture, a live control panel, presets, upload and a SSRF-guarded URL import.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets/default-bg.jpg",
    "assets/screenshot-panel.png",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "docs-zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1020252969/dsh-wallpaper.git"
  },
  "homepage": "https://github.com/1020252969/dsh-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/1020252969/dsh-wallpaper/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "background",
    "theme",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
